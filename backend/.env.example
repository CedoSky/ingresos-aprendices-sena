FLASK_ENV=development
DEBUG=True

# ── Base de datos PostgreSQL ──────────────────────────────
# NUNCA uses contraseñas reales aquí. Este es sólo un ejemplo.
# Genera una contraseña segura y úsala en tu archivo .env real (que NO debes subir a git).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASENA_SEGURA
POSTGRES_DB=sena_aprendices_dev
DATABASE_URL=postgresql://postgres:CAMBIA_ESTA_CONTRASENA_SEGURA@localhost:5432/sena_aprendices_dev

AWS_ACCESS_KEY_ID=tu-access-key-aqui
AWS_SECRET_ACCESS_KEY=tu-secret-key-aqui
AWS_S3_BUCKET=tu-bucket-s3-aqui
AWS_REGION=us-east-1

# Genera claves seguras con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CAMBIA_ESTA_CLAVE_SECRETA_FLASK
JWT_SECRET_KEY=CAMBIA_ESTA_CLAVE_SECRETA_JWT

# PIN de acceso al panel de sistemas (solo para soporte técnico / programadores)
# Para configurarlo ejecuta MANTENIMIENTO.bat -> opción "Configurar PIN de sistemas"
# NUNCA uses un PIN obvio. Combina letras, números y símbolos.
DEV_PIN=
