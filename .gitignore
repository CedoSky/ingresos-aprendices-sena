*.db
*.sqlite
*.sqlite3
instance/
sena.db
*.backup
*.sql

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
ENV/
*.egg-info/
dist/
build/
.tox/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Logs (excepto documentación)
*.log
logs/
*.out

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Node (si existe)
node_modules/
npm-debug.log

# Respaldos locales
RESPALDOS_USB/

# Otros
.git/
*.bak
*.tmp
.cache/

# Sistema operativo
.DS_Store
Thumbs.db

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo
sublime-project
sublime-workspace

# Respaldos y temporales
RESPALDOS_USB/
respaldos_locales/
