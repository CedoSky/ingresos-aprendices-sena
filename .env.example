# ============================================================================
#  VARIABLES DE ENTORNO - SENA SISTEMA DE INGRESOS Y SALIDAS
# ============================================================================
# Copia este archivo a .env y rellena con tus valores reales

# ── SEGURIDAD ──────────────────────────────────────────────────────────────
# Genera cada clave con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar_esto_por_valor_aleatorio_largo
JWT_SECRET_KEY=cambiar_esto_por_valor_aleatorio_largo
# Obligatoria y debe ser ESTABLE entre reinicios (si cambia, los datos ya
# encriptados dejan de poder leerse). Genera con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

ADMIN_PASSWORD=
VIGILANTE_PASSWORD=

# ── AMBIENTE ───────────────────────────────────────────────────────────────
FLASK_ENV=development
# Opciones: development, production, testing
FLASK_PORT=8000
NGINX_PORT=80
NGINX_SSL_PORT=443

# ── BASE DE DATOS ──────────────────────────────────────────────────────────
# LOCAL (SQLite):
# DATABASE_URL=sqlite:///sena.db

# Usadas por docker-compose.yml para levantar PostgreSQL propio
POSTGRES_USER=sena_user
POSTGRES_PASSWORD=cambiar_esta_contrasena
POSTGRES_DB=sena_aprendices
POSTGRES_PORT=5432

# Redis (opcional, actualmente no lo usa el backend, solo lo levanta el compose)
REDIS_PASSWORD=cambiar_esta_contrasena
REDIS_PORT=6379

# REMOTA (PostgreSQL en Render/AWS/Azure):
# La proporciona automáticamente el proveedor de nube
# Formato: postgresql://usuario:password@host:5432/basedatos
DATABASE_URL=

# ── AWS S3 (Respaldos en nube) ─────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# ── WOMPI (Pasarela de pagos colombiana) ───────────────────────────────────
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_ENV=sandbox
# Cambia a 'prod' cuando estés en producción

# ── CORREO (Gmail) ─────────────────────────────────────────────────────────
GMAIL_REMITENTE=tu_email@gmail.com
GMAIL_APP_PASSWORD=
# Obtener en: https://myaccount.google.com/apppasswords
GMAIL_NOMBRE=SENA — Sistema de Ingresos
ADMIN_EMAIL=admin@sena.edu.co

# ── ALMACENAMIENTO DE RESPALDOS ────────────────────────────────────────────
# Opciones: usb, network, s3
STORAGE_BACKEND=usb
USB_BACKUP_FOLDER=SENA_RESPALDOS
USB_PATH_OVERRIDE=
# USB_PATH_OVERRIDE=E:/  (si quieres forzar una ruta)

# ── RESPALDO EN RED (otra laptop con carpeta compartida) ───────────────────
NETWORK_BACKUP_PATH=
NETWORK_USERNAME=
NETWORK_PASSWORD=
NETWORK_TIMEOUT=5

# ── PIN DINÁMICO (Código de mantenimiento) ─────────────────────────────────
DEV_PIN_SECRET=
# Se genera automáticamente con MANTENIMIENTO.bat

# ── CORS (Dominios permitidos) ─────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,https://tu-dominio.com

# ── ESP32 / MQTT (control TRIAC) ───────────────────────────────────────────
ESP32_IP=192.168.1.100
ESP32_TIMEOUT=10
MQTT_BROKER=
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=

# ── USB (LOCAL ONLY) ───────────────────────────────────────────────────────
USE_USB=false
# En producción debe ser false
